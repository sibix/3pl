
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Consignment Entry Tool</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --ink:#1c2b24;
    --paper:#f6f4ee;
    --line:#d8d2c2;
    --accent:#2f6f4f;
    --accent-dark:#204c37;
    --warn:#a5432b;
    --card:#ffffff;
    --mono: 'Courier New', monospace;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Segoe UI', Arial, sans-serif;
    background:var(--paper);
    color:var(--ink);
    padding:24px;
  }
  h1{
    font-size:22px;
    letter-spacing:0.3px;
    margin:0 0 4px 0;
    color:var(--accent-dark);
  }
  .sub{
    color:#5b6960;
    font-size:13px;
    margin-bottom:20px;
  }
  .panel{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px 20px;
    margin-bottom:18px;
  }
  .panel h2{
    font-size:14px;
    text-transform:uppercase;
    letter-spacing:0.6px;
    margin:0 0 12px 0;
    color:var(--accent-dark);
    display:flex;
    align-items:center;
    gap:8px;
  }
  .step-num{
    background:var(--accent);
    color:#fff;
    width:20px;height:20px;
    border-radius:50%;
    display:inline-flex;align-items:center;justify-content:center;
    font-size:11px;
  }
  input[type=file]{
    font-size:13px;
  }
  .status{
    font-size:13px;
    margin-top:10px;
    color:#3d4a42;
  }
  .status b{color:var(--accent-dark);}
  textarea{
    width:100%;
    min-height:180px;
    font-family:var(--mono);
    font-size:13px;
    padding:10px;
    border:1px solid var(--line);
    border-radius:6px;
    resize:vertical;
    background:#fdfcf8;
  }
  .hint{
    font-size:12px;
    color:#7a8579;
    margin-top:6px;
    line-height:1.5;
  }
  button{
    font-family:inherit;
    font-size:13px;
    border:none;
    border-radius:6px;
    padding:9px 16px;
    cursor:pointer;
    font-weight:600;
    letter-spacing:0.2px;
  }
  .btn-primary{background:var(--accent); color:#fff;}
  .btn-primary:hover{background:var(--accent-dark);}
  .btn-secondary{background:#eae6d9; color:var(--ink);}
  .btn-secondary:hover{background:#ddd7c4;}
  .btn-danger{background:transparent; color:var(--warn); padding:4px 8px; font-size:12px;}
  .btn-danger:hover{text-decoration:underline;}
  button:disabled{opacity:0.45; cursor:not-allowed;}
  .actions{margin-top:12px; display:flex; gap:10px;}
  table{
    width:100%;
    border-collapse:collapse;
    font-size:12.5px;
    margin-top:14px;
  }
  th, td{
    border:1px solid var(--line);
    padding:6px 8px;
    text-align:left;
    vertical-align:top;
  }
  th{
    background:#eef1e9;
    font-weight:600;
    color:var(--accent-dark);
  }
  td input{
    width:100%;
    border:1px solid #cfd6cb;
    border-radius:4px;
    padding:4px 6px;
    font-size:12.5px;
    font-family:inherit;
  }
  .preview-wrap{overflow-x:auto;}
  .empty-note{
    font-size:13px;
    color:#8a9188;
    padding:14px 0;
  }
  .pill{
    display:inline-block;
    background:var(--accent);
    color:#fff;
    border-radius:20px;
    padding:1px 9px;
    font-size:11.5px;
    margin-left:6px;
  }
  .filename{font-family:var(--mono); font-size:12.5px; color:var(--accent-dark);}
</style>
</head>
<body>

<h1>Consignment Entry Tool</h1>
<div class="sub">Load your CPDP consignment Excel file, paste customer details, review, and insert as new rows — then download the updated file.</div>

<!-- STEP 1: LOAD FILE -->
<div class="panel">
  <h2><span class="step-num">1</span>Load the Excel file</h2>
  <input type="file" id="fileInput" accept=".xlsx" />
  <div class="status" id="loadStatus">No file loaded yet.</div>
</div>

<!-- STEP 2: PASTE DATA -->
<div class="panel">
  <h2><span class="step-num">2</span>Paste customer data</h2>
  <textarea id="pasteArea" placeholder="Paste one or more entries here, e.g.

2)
Kannan
Madayil house
Kodumunda.po
Patambi
Palakkad
PIN:679303
Ph:7994264610

3.Musthafa
Kuttoor parambu
Karanthur p. o
Kunnamangalam
Kozhikkode
Pin-673571
Pho-9745774122
(1299)"></textarea>
  <div class="hint">Separate multiple entries with a blank line. Each entry: name, address lines, a line with PIN, a line with phone number. You can edit any parsed field below before inserting.</div>
  <div class="actions">
    <button class="btn-primary" id="parseBtn" disabled>Parse entries</button>
  </div>
</div>

<!-- STEP 3: REVIEW & INSERT -->
<div class="panel">
  <h2><span class="step-num">3</span>Review parsed entries</h2>
  <div id="previewWrap"><div class="empty-note">Parsed entries will appear here for review before inserting.</div></div>
  <div class="actions">
    <button class="btn-primary" id="insertBtn" disabled>Insert into sheet</button>
  </div>
</div>

<!-- STEP 4: CURRENT ROWS + DOWNLOAD -->
<div class="panel">
  <h2><span class="step-num">4</span>Rows in sheet <span class="pill" id="rowCountPill">0</span></h2>
  <div id="rowsWrap"><div class="empty-note">No rows loaded yet.</div></div>
  <div class="actions">
    <button class="btn-secondary" id="downloadBtn" disabled>Download updated Excel</button>
  </div>
</div>

<script>
const SHEET_NAME = 'consignment';
// Column indices (0-based) for the dynamic fields
const COL = { name:2, addr1:3, addr2:4, phone:5, pin:6 };

let workbook = null;
let header = [];
let templateRow = []; // row 2 values, used as base for static columns
let rows = [];         // array of arrays, current data rows (excluding header)
let refIndex = 0;      // for column A auto-increment (Customer Reference Number)
let parsedEntries = []; // entries parsed from textarea, pending insert

const fileInput = document.getElementById('fileInput');
const loadStatus = document.getElementById('loadStatus');
const parseBtn = document.getElementById('parseBtn');
const insertBtn = document.getElementById('insertBtn');
const downloadBtn = document.getElementById('downloadBtn');
const pasteArea = document.getElementById('pasteArea');
const previewWrap = document.getElementById('previewWrap');
const rowsWrap = document.getElementById('rowsWrap');
const rowCountPill = document.getElementById('rowCountPill');

fileInput.addEventListener('change', handleFile);
parseBtn.addEventListener('click', parseEntries);
insertBtn.addEventListener('click', insertEntries);
downloadBtn.addEventListener('click', downloadFile);

function handleFile(e){
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(evt){
    try{
      const data = new Uint8Array(evt.target.result);
      workbook = XLSX.read(data, {type:'array'});
      if(!workbook.SheetNames.includes(SHEET_NAME)){
        loadStatus.innerHTML = `<b style="color:#a5432b">Sheet "${SHEET_NAME}" not found.</b> Sheets found: ${workbook.SheetNames.join(', ')}`;
        return;
      }
      const ws = workbook.Sheets[SHEET_NAME];
      const aoa = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
      header = aoa[0] || [];
      templateRow = aoa[1] ? aoa[1].slice() : [];
      rows = aoa.slice(1).map(r => r.slice());

      // establish starting reference number from column A of existing rows
      let maxRef = 0;
      rows.forEach(r=>{
        const v = parseInt(r[0], 10);
        if(!isNaN(v)) maxRef = Math.max(maxRef, v);
      });
      refIndex = maxRef;

      loadStatus.innerHTML = `Loaded <span class="filename">${file.name}</span> — <b>${rows.length}</b> existing row(s) in "${SHEET_NAME}".`;
      parseBtn.disabled = false;
      downloadBtn.disabled = false;
      renderRows();
    }catch(err){
      loadStatus.innerHTML = `<b style="color:#a5432b">Could not read file:</b> ${err.message}`;
    }
  };
  reader.readAsArrayBuffer(file);
}

function parseEntries(){
  const text = pasteArea.value;
  const blocks = text.split(/\n\s*\n/).map(b=>b.trim()).filter(b=>b.length>0);
  parsedEntries = blocks.map(parseBlock);
  renderPreview();
  insertBtn.disabled = parsedEntries.length === 0;
}

function parseBlock(block){
  let lines = block.split('\n').map(l=>l.trim()).filter(l=>l.length>0);
  if(lines.length === 0) return {name:'', addr1:'', addr2:'', phone:'', pin:''};

  // strip a leading index like "2)" or "3." from the first line
  let first = lines[0];
  const stripped = first.replace(/^\s*\d+\s*[\.\)]\s*/, '');
  if(stripped.trim().length > 0){
    lines[0] = stripped.trim();
  } else {
    lines.shift(); // index was on its own line; name is the next line
  }
  if(lines.length === 0) return {name:'', addr1:'', addr2:'', phone:'', pin:''};

  const name = lines.shift();

  // find PIN line and Phone line among remaining lines
  let pinIdx = lines.findIndex(l => /pin/i.test(l));
  let phoneIdx = lines.findIndex(l => /\b(ph|pho|phone)\b/i.test(l));

  let addrLines = [];
  let pin = '', phone = '';

  lines.forEach((l, i) => {
    if(i === pinIdx){
      const m = l.match(/(\d{5,7})/);
      pin = m ? m[1] : l.replace(/pin/i,'').replace(/[:\-]/g,'').trim();
    } else if(i === phoneIdx){
      const m = l.match(/(\d{7,15})/);
      phone = m ? m[1] : l.replace(/ph(one)?o?/i,'').replace(/[:\-]/g,'').trim();
    } else if(i < (pinIdx === -1 ? lines.length : pinIdx)) {
      // address / district lines occur before the PIN line
      // ignore trailing lines like "(1299)" that come after phone
      addrLines.push(l);
    }
  });

  let addr1 = '', addr2 = '';
  if(addrLines.length === 1){
    addr1 = addrLines[0];
  } else if(addrLines.length >= 2){
    addr1 = addrLines[0];
    // drop the last address line (treated as district, matches sheet convention)
    const middle = addrLines.slice(1, addrLines.length - 1);
    addr2 = middle.join(', \n');
  }

  return {name, addr1, addr2, phone, pin};
}

function renderPreview(){
  if(parsedEntries.length === 0){
    previewWrap.innerHTML = '<div class="empty-note">No entries parsed. Paste data above and click "Parse entries".</div>';
    return;
  }
  let html = '<div class="preview-wrap"><table><thead><tr>' +
    '<th style="width:4%">#</th><th>Name</th><th>Address Line 1</th><th>Address Line 2</th><th>Phone</th><th>Pincode</th><th style="width:6%"></th>' +
    '</tr></thead><tbody>';
  parsedEntries.forEach((e, i) => {
    html += `<tr data-idx="${i}">
      <td>${i+1}</td>
      <td><input data-field="name" value="${escapeAttr(e.name)}"></td>
      <td><input data-field="addr1" value="${escapeAttr(e.addr1)}"></td>
      <td><input data-field="addr2" value="${escapeAttr(e.addr2.replace(/\n/g,' '))}"></td>
      <td><input data-field="phone" value="${escapeAttr(e.phone)}"></td>
      <td><input data-field="pin" value="${escapeAttr(e.pin)}"></td>
      <td><button class="btn-danger" onclick="removeParsed(${i})">Remove</button></td>
    </tr>`;
  });
  html += '</tbody></table></div>';
  previewWrap.innerHTML = html;

  previewWrap.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('input', (e)=>{
      const tr = e.target.closest('tr');
      const idx = parseInt(tr.dataset.idx, 10);
      const field = e.target.dataset.field;
      parsedEntries[idx][field] = e.target.value;
    });
  });
}

function removeParsed(i){
  parsedEntries.splice(i,1);
  renderPreview();
  insertBtn.disabled = parsedEntries.length === 0;
}

function insertEntries(){
  if(parsedEntries.length === 0) return;
  parsedEntries.forEach(e => {
    const newRow = templateRow.slice(); // copy static columns from row 2
    refIndex += 1;
    newRow[0] = refIndex;         // Customer Reference Number, auto-incremented
    newRow[COL.name] = e.name;
    newRow[COL.addr1] = e.addr1;
    newRow[COL.addr2] = e.addr2;
    newRow[COL.phone] = e.phone;
    newRow[COL.pin] = e.pin;
    rows.push(newRow);
  });
  parsedEntries = [];
  pasteArea.value = '';
  insertBtn.disabled = true;
  renderPreview();
  renderRows();
}

function renderRows(){
  rowCountPill.textContent = rows.length;
  if(rows.length === 0){
    rowsWrap.innerHTML = '<div class="empty-note">No rows loaded yet.</div>';
    return;
  }
  let html = '<div class="preview-wrap"><table><thead><tr>' +
    '<th>Ref#</th><th>Name</th><th>Address Line 1</th><th>Address Line 2</th><th>Phone</th><th>Pincode</th><th style="width:6%"></th>' +
    '</tr></thead><tbody>';
  rows.forEach((r, i) => {
    html += `<tr>
      <td>${escapeHtml(r[0])}</td>
      <td>${escapeHtml(r[COL.name])}</td>
      <td>${escapeHtml(r[COL.addr1])}</td>
      <td>${escapeHtml(String(r[COL.addr2]).replace(/\n/g,' '))}</td>
      <td>${escapeHtml(r[COL.phone])}</td>
      <td>${escapeHtml(r[COL.pin])}</td>
      <td><button class="btn-danger" onclick="removeRow(${i})">Remove</button></td>
    </tr>`;
  });
  html += '</tbody></table></div>';
  rowsWrap.innerHTML = html;
}

function removeRow(i){
  rows.splice(i,1);
  renderRows();
}

function downloadFile(){
  if(!workbook) return;
  const aoa = [header, ...rows];
  const newSheet = XLSX.utils.aoa_to_sheet(aoa);
  workbook.Sheets[SHEET_NAME] = newSheet;
  if(!workbook.SheetNames.includes(SHEET_NAME)){
    workbook.SheetNames.push(SHEET_NAME);
  }
  XLSX.writeFile(workbook, 'CPDP-Consignment-upload.xlsx');
}

function escapeAttr(s){
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
}
function escapeHtml(s){
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
</body>
</html>
